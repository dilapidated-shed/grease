#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) {
  echo 'usage: grease build.grease GREASE_REPOSITORY GENERATED_SOURCE NDK ABI SOURCE_SHA NEW_OUTPUT' >&2; exit 2
}
var repository = ARGV[0]
var source = ARGV[1]
var ndk = ARGV[2]
var abi = ARGV[3]
var source_sha = ARGV[4]
var output = ARGV[5]
var grease = ENV.IB_GREASE
for path in "$repository" "$source" "$ndk" "$output" "$grease" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute Android build path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL reused Android runtime output' >&2; exit 2 }
var expected = $(git -C "$repository" rev-parse HEAD:source)
if (source_sha !== expected) { echo 'FAIL generated runtime source differs from current gitlink' >&2; exit 1 }
rg -x -F 'Pkg.Revision = 27.2.12479018' "$ndk/source.properties"
test -x "$source/_build/oils.sh"
var target = 'x86_64-linux-android29'
var machine = 'Advanced Micro Devices X86-64'
if (abi === 'armeabi-v7a') { setvar target = 'armv7a-linux-androideabi29'; setvar machine = 'ARM' }
if (abi === 'arm64-v8a') { setvar target = 'aarch64-linux-android29'; setvar machine = 'AArch64' }
if (abi !== 'x86_64' and abi !== 'armeabi-v7a' and abi !== 'arm64-v8a') { echo 'FAIL unsupported Android ABI' >&2; exit 2 }
var tools = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
test -x "$tools/$target-clang"
test -x "$tools/$target-clang++"
mkdir -p "$output/wrappers" "$output/receipts"
# These host wrappers are Grease programs, not replacement target runtimes.
printf '#!%s\n' "$grease" > "$output/wrappers/ib-android-clang++"
cat >> "$output/wrappers/ib-android-clang++" <<'GREASE'
var compiler = ENV.IB_ANDROID_CXX
exec "$compiler" @ARGV
GREASE
printf '#!%s\n' "$grease" > "$output/wrappers/strip"
cat >> "$output/wrappers/strip" <<'GREASE'
var program = ENV.IB_ANDROID_STRIP
exec "$program" @ARGV
GREASE
chmod 755 "$output/wrappers/ib-android-clang++" "$output/wrappers/strip"
setglobal ENV.IB_ANDROID_CXX = "$tools/$target-clang++"
setglobal ENV.IB_ANDROID_STRIP = "$tools/llvm-strip"
setglobal ENV.PATH = "$output/wrappers:$(dirname "$grease"):" ++ ENV.PATH
"$grease" "$repository/examples/autogenerated/android-worker-runtime/configure-probe.grease" "$source" "$tools/$target-clang" \
  > "$output/receipts/configure.txt" 2>&1
cat "$output/receipts/configure.txt"
cd "$source"
env OILS_PARALLEL_BUILD=2 LDFLAGS='-static-libstdc++ -Wl,-z,max-page-size=16384' \
  ./_build/oils.sh --cxx ib-android-clang++ --variant opt --without-readline \
  > "$output/receipts/build.txt" 2>&1
var runtime = "$source/_bin/ib-android-clang++-opt-sh/oils-for-unix.stripped"
test -x "$runtime"
"$tools/llvm-readelf" -h -l -d "$runtime" > "$output/receipts/elf.txt"
rg -F "Machine:                           $machine" "$output/receipts/elf.txt"
if rg -q 'NEEDED.*libc\+\+_shared\.so' "$output/receipts/elf.txt" {
  echo 'FAIL undeclared Android C++ shared runtime dependency' >&2; exit 1
}
cp "$runtime" "$output/libib_grease.so"
chmod 555 "$output/libib_grease.so"
cp "$source/_build/detected-cpp-config.h" "$output/receipts/detected-cpp-config.h"
cp "$source/_build/detected-config.sh" "$output/receipts/detected-config.sh"
cp "$ndk/source.properties" "$output/receipts/ndk.properties"
"$tools/$target-clang++" --version > "$output/receipts/compiler.txt"
git -C "$repository" rev-parse HEAD > "$output/receipts/packaging-commit.txt"
printf '%s\n' "$source_sha" > "$output/receipts/source-commit.txt"
sha256sum "$output/libib_grease.so" "$source/_build/oils.sh" \
  "$repository/examples/autogenerated/android-worker-runtime/build.grease" > "$output/receipts/sha256.txt"
printf 'schema\tgrease-Android-worker-build-v1\nabi\t%s\napi_floor\t29\nimplementation\tcurrent Grease source gitlink\nentry_mode\tysh\nprofile\topt without-readline, retained configure fast mode with GC_TIMING\nsource_generation\tinherited Oils/MyCPP toolchain\ntarget_compiler\texplicit NDK Clang++ 27.2.12479018\nAndroid_execution\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' "$abi" > "$output/receipts/receipt.tsv"
cat "$output/receipts/receipt.tsv"
