#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: grease prepare.grease REPOSITORY SOURCE_WORKTREE NDK NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var upstream = ARGV[1]
var ndk = ARGV[2]
var evidence = ARGV[3]
var grease = ENV.IB_GREASE
for path in "$repository" "$upstream" "$ndk" "$evidence" { if (path[0] !== '/') { exit 2 } }
if test -e "$evidence" { echo 'FAIL reused native source build' >&2; exit 2 }
var expected = $(git -C "$repository" rev-parse HEAD:source)
if ($(git -C "$upstream" rev-parse HEAD) !== expected) { echo 'FAIL source worktree pin' >&2; exit 1 }
if ($(cat "$upstream/_tmp/soil/commit-hash.txt") !== expected) { echo 'FAIL container source pin' >&2; exit 1 }
cd "$upstream"
./soil/host-shim.sh did-all-succeed cpp-tarball
mkdir -p "$evidence"
test -s "$upstream/_release/oils-for-unix.tar"
cp "$upstream/_release/oils-for-unix.tar" "$evidence/generated-source.tar"
sha256sum "$evidence/generated-source.tar" > "$evidence/generated-source.sha256"
cp "$upstream/_tmp/soil/commit-hash.txt" "$evidence/generated-source-commit.txt"
for abi in x86_64 armeabi-v7a arm64-v8a {
  var extraction = "$evidence/$abi-source"
  mkdir -p "$extraction"
  tar --no-same-owner -xf "$evidence/generated-source.tar" -C "$extraction"
  var source = $(find "$extraction" -mindepth 1 -maxdepth 1 -type d -name 'oils-for-unix-*')
  test -x "$source/_build/oils.sh"
  "$grease" "$repository/examples/autogenerated/android-worker-runtime/build.grease" \
    "$repository" "$source" "$ndk" "$abi" "$expected" "$evidence/$abi"
}
git -C "$repository" rev-parse HEAD > "$evidence/packaging-commit.txt"
printf '%s\n' "$expected" > "$evidence/source-commit.txt"
